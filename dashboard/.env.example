# Ocean-bot dashboard environment.

# ----- Database -----
# Connection to the bot's Postgres DB (same one the bot writes to).
# Use the Neon "pooled" connection string when running on Railway.
OCEAN_BOT_DATABASE_URL=postgres://user:pass@host:5432/oceanbot

# ----- Auth.js -----
# Random secret for JWT signing. Generate with:  openssl rand -base64 32
AUTH_SECRET=

# Public URL of the dashboard. Required on any non-Vercel host —
# Auth.js uses this for callback URLs in /api/auth/providers.
# Behind Railway's edge the in-container req.url is localhost:8080,
# which produces broken sign-in links if AUTH_URL is unset.
AUTH_URL=https://ocean-bot-dashboard-production.up.railway.app

# Tell Auth.js to trust the public host (required on any non-Vercel
# host with v5; default policy is "untrusted" → middleware fails open).
AUTH_TRUST_HOST=true

# GitHub OAuth App credentials. Create one at:
#   https://github.com/settings/applications/new
# Callback URL must be: <AUTH_URL>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ----- Single-user gate -----
# Your GitHub numeric user id (string). Find with:
#   curl https://api.github.com/users/<your-username> | jq .id
# The dashboard middleware blocks anyone whose token doesn't match.
OCEAN_USER_ID=

# ----- Dev-only overrides (NEVER set in production) -----
# When set to "1" AND NODE_ENV != "production", bypasses the auth gate
# entirely so you can poke the UI locally without GitHub OAuth.
# OCEAN_BOT_DEV_BYPASS_AUTH=1
